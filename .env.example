# Azure Foundry (OpenAI-compatible): one endpoint, one key for chat + embeddings
AZURE_FOUNDRY_ENDPOINT=https://niftyai-resource.services.ai.azure.com/openai/v1
AZURE_FOUNDRY_API_KEY=

# Model deployments on that endpoint. The app reads both names from env;
 if unset, it falls back to the defaults shown here.
AZURE_FOUNDRY_CHAT_MODEL=FW-Kimi-K3
AZURE_FOUNDRY_EMBED_MODEL=text-embedding-3-large

# Neon Postgres (with pgvector)
# Tip for serverless (Vercel): use the POOLER host (...-pooler.neon.tech) so
# short-lived lambdas share connections; the direct host exhausts Neon
# free-tier connection limits fast.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Vercel Cron secret: required in production; Vercel sends it as
# `Authorization: Bearer <CRON_SECRET>` when hitting /api/admin/consolidate.
# Leave empty in local dev (endpoint stays open).
CRON_SECRET=
