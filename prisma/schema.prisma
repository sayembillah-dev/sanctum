// Sanctum — Prisma schema.
// NOTE: DDL stays SQL-owned (db/migrations/*.sql, auto-applied by scripts/migrate.mjs)
// because Prisma can't manage pgvector column types. This schema mirrors the SQL
// so the client is fully typed; embedding columns are Unsupported and written
// via raw SQL only. After editing, run: npx prisma generate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Dump {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  raw_text   String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  edges      Edge[]

  @@map("dumps")
}

model Node {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type              String
  name              String
  attrs             Json                    @default("{}")
  embedding         Unsupported("vector(1536)")?
  created_at        DateTime                @default(now()) @db.Timestamptz(6)
  updated_at        DateTime                @default(now()) @db.Timestamptz(6)
  valid_to          DateTime?               @db.Date
  // ── Grows-With-You: salience (003) ──
  mention_count     Int                     @default(1) // strengthened every time extraction re-encounters this entity
  last_recalled_at  DateTime?               @db.Timestamptz(6)
  recall_used_count Int                     @default(0) // how often a reply actually cited this memory
  pinned            Boolean                 @default(false) // the user's profile node — never decays, always in context
  outgoing          Edge[]                  @relation("src")
  incoming          Edge[]                  @relation("dst")

  @@map("nodes")
}

model Edge {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  src_id         String    @db.Uuid
  dst_id         String    @db.Uuid
  type           String
  attrs          Json      @default("{}")
  said_on        DateTime? @db.Date
  valid_from     DateTime? @db.Date
  valid_to       DateTime? @db.Date
  source_dump_id String?   @db.Uuid
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  src            Node      @relation("src", fields: [src_id], references: [id], onDelete: Cascade)
  dst            Node      @relation("dst", fields: [dst_id], references: [id], onDelete: Cascade)
  dump           Dump?     @relation(fields: [source_dump_id], references: [id])

  @@map("edges")
}

model Feedback {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rating        Int      @db.SmallInt // +1 / -1
  user_msg      String
  assistant_msg String
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@map("feedback")
}

// ── Conversation persistence (005) ──
model ChatMessage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id String   @db.Uuid
  role       String // 'user' | 'assistant'
  content    String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("chat_messages")
}

model AppState {
  key   String @id
  value Json

  @@map("app_state")
}

// ── Conversation titles (006) ──
model ChatSession {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String?
  title_source String   @default("derived") // derived (instant slice) < llm (upgraded) < user (manual)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@map("chat_sessions")
}

// ── Auth (007) — better-auth core tables. Mirror of 007_auth.sql. ──
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(6)
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("verification")
}
